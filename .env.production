# Committed on purpose: the public API URL used for PRODUCTION builds (Vercel).
# Not a secret. Vite bakes this into the build, so Vercel needs no dashboard var.
# Local dev/build still uses .env.local (localhost), which has higher priority.
# To move to the Mac Mini later, change this URL (or set VITE_API_BASE in Vercel,
# which overrides this).
VITE_API_BASE="https://grynx-api.onrender.com"
