# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.vercel/

# Env & secrets
.env
.env.*
!.env.example
!.env.production

# Screenshot artifacts (visual QA)
_shots/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.suo
*.user

# Large binary UI references are kept in repo intentionally (source of truth),
# but ignore scratch exports:
reference/**/_scratch/

# Firebase Admin service account (SECRET — never commit). Provide it via the
# FIREBASE_SERVICE_ACCOUNT env var, or GOOGLE_APPLICATION_CREDENTIALS path.
**/serviceAccountKey.json
**/firebase-service-account*.json

# Capacitor / Android local signing + SDK config
android/local.properties
*.keystore
*.jks
