// GRYNX backend data model — single source of truth.
// Maps docs/02 (schema) + docs/06 (state machine) + docs/10 (scan engine).
// Conventions: uuid PKs, createdAt/updatedAt, soft-status (never hard delete),
// optimistic-lock `version` where concurrency matters (jobs, jobSteps).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── enums ─────────────────────────
enum UserStatus {
  active
  suspended
  pending
}

enum Role {
  admin
  ppc
  sales // creates sale sheets that feed PPC requests
  dept_head
  qc
  fg_stock
  maintenance
}

enum Platform {
  web
  ios
  android
  windows
}

enum Priority {
  normal
  urgent
}

enum JobType {
  production
  rework
}

enum JobSource {
  admin
  ppc
}

enum JobStatus {
  draft
  pending_approval
  approved
  in_production
  in_qc
  in_fg
  close_requested
  closed
  cancelled
}

enum StepStatus {
  pending
  waiting_acceptance
  in_progress
  on_hold
  completed
  skipped
}

enum PpcStatus {
  draft
  submitted
  clarification
  pending_confirm
  approved
  rejected
  cancelled
}

enum EventType {
  created
  accepted
  completed
  hold
  resume
  note
  update_request
  update_reply
  qc_result
  scan
  split
  merge
  cancelled
  closure_requested
  closed
  forced_advance
  station_in // production station scan-in
  station_out // production station scan-out (explicit or auto ★)
  material_request // design/floor raised a raw-material / purchase need
  material_update // material need status changed (ordered/received)
  sale_sheet // a sale sheet was created and handed to PPC
  serialized // FG entered a serial number on a finished unit
}

enum AttachmentKind {
  image
  pdf
  video
}

enum HoldCode {
  material
  breakdown
  approval
  resource
  other
}

enum QcResult {
  approved
  rework
}

enum ClosureStatus {
  requested
  approved
  rejected
}

enum MaintCategory {
  electrical
  mechanical
  utility
  facility
  it_network
  safety
  other
}

enum MaintPriority {
  critical
  high
  normal
  low
}

enum MaintStatus {
  open
  assigned
  in_progress
  completed
  verified
  closed
}

enum NotificationType {
  new_job
  update_request
  hold_alert
  ppc_approval
  maintenance_alert
  closure_request
  escalation
}

enum ScanResult {
  applied
  duplicate
  rejected_out_of_seq
  forced
  superseded
}

// how a production station visit ended: an operator scan-out (real time) vs.
// auto-closed because they forgot and the job moved on (rendered with a ★).
enum ScanOutMode {
  explicit
  auto
}

// a raw-material / purchase need raised against a job. Actual ordering happens
// off-app; production keeps working on available parts meanwhile (non-blocking).
enum MaterialStatus {
  needed
  ordered
  received
  cancelled
}

// lifecycle of a sale sheet from the Sales desk into PPC.
enum SaleSheetStatus {
  draft
  submitted // handed to PPC
  converted // turned into a PPC request
  cancelled
}

// ── workflow engine (docs/12) ──
// A stage's TYPE drives its behaviour/screen (code); its arrangement + config are
// data in a WorkflowVersion. Department-backed types map to a Department row;
// sales/dispatch/etc. are stages with no station.
enum StageType {
  sales
  ppc_requirements
  fg_check
  design
  ppc_final
  production
  qc
  fg_stock
  dispatch
  maintenance
}

enum WorkflowStatus {
  draft
  published
  archived
}

// order-layer (docs/12): a Sales order spawns sub-Jobs for items not in stock.
// Coarse human-set lifecycle; production progress is derived from the order's jobs.
enum OrderStatus {
  draft // sales drafting
  submitted // handed to PPC
  planning // PPC checking stock / raising jobs
  in_production // ≥1 job on the floor
  ready // all jobs done → in FG, awaiting dispatch
  dispatched // shipped (phase 6)
  closed
  cancelled
  on_hold
}

enum SuggestionKind {
  update_request
  escalation
  bottleneck
  hold_review
  approval
}

enum Severity {
  info
  warn
  alert
}

enum SuggestionStatus {
  open
  accepted
  dismissed
}

// ───────────────────────── identity & org ─────────────────────────
model User {
  id                String     @id @default(uuid())
  username          String     @unique
  fullName          String
  passwordHash      String? // office users
  pinHash           String? // floor users (argon2)
  status            UserStatus @default(active)
  lastLoginAt       DateTime?
  webauthnChallenge String? // short-lived challenge for the in-flight ceremony
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  roles               RoleAssignment[]
  devices             DeviceToken[]
  scans               ScanEvent[]
  webauthnCredentials WebauthnCredential[]
  pushTokens          PushToken[]
}

// FCM push registration token for a user's device (Capacitor Android app). Used
// to deliver notifications when the app is backgrounded/closed.
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// A registered platform authenticator (Face ID / Touch ID / fingerprint) bound
// to a device. credentialId/publicKey are base64url. Domain-bound: credentials
// only work on the rpID (origin) they were registered on.
model WebauthnCredential {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String? // comma-joined hints (internal, hybrid, …)
  label        String? // human device label
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Department {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  sortOrder Int        @default(0)
  type      StageType? // workflow-engine: which stage type this department backs

  roles          RoleAssignment[]
  templateSteps  PipelineTemplateStep[]
  jobSteps       JobStep[]
  scans          ScanEvent[]
  floorDevices   DeviceToken[]
  stations       Station[] // production sub-stations (only the PRODUCTION dept has these)
  workflowStages WorkflowStage[]
}

model RoleAssignment {
  id           String      @id @default(uuid())
  userId       String
  role         Role
  departmentId String? // null for global roles (admin, ppc)
  isBackup     Boolean     @default(false)
  user         User        @relation(fields: [userId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([userId])
}

model DeviceToken {
  id            String      @id @default(uuid())
  userId        String
  platform      Platform
  token         String
  isFloorDevice Boolean     @default(false)
  departmentId  String? // station binding for floor scanners (docs/10)
  user          User        @relation(fields: [userId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
}

// ───────────────────────── catalogue (Product Master) ─────────────────────────
model Product {
  id          String  @id @default(uuid())
  code        String  @unique // e.g. AT
  name        String
  description String?
  active      Boolean @default(true)

  models     Model[]
  pipelines  PipelineTemplate[]
  jobs       Job[]
  ppc        PpcRequest[]
  orderItems OrderItem[]
  stockItems StockItem[]
}

model Model {
  id        String   @id @default(uuid())
  productId String
  code      String
  name      String
  sizes     String[] @default([]) // available lengths, e.g. ["3M","2M","1M"]
  active    Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id])

  jobModels  JobModel[]
  ppcModels  PpcRequestModel[]
  orderItems OrderItem[]
  stockItems StockItem[]

  @@unique([productId, code])
}

model PipelineTemplate {
  id        String                 @id @default(uuid())
  productId String
  name      String
  isDefault Boolean                @default(false)
  product   Product                @relation(fields: [productId], references: [id])
  steps     PipelineTemplateStep[]
  jobs      Job[]
  ppc       PpcRequest[]
}

model PipelineTemplateStep {
  id           String           @id @default(uuid())
  templateId   String
  departmentId String
  sequence     Int
  template     PipelineTemplate @relation(fields: [templateId], references: [id])
  department   Department       @relation(fields: [departmentId], references: [id])

  @@unique([templateId, sequence])
}

// admin-editable config (hold reasons, SLA thresholds, etc.)
model HoldReason {
  id     String  @id @default(uuid())
  code   String  @unique
  label  String
  active Boolean @default(true)
}

model Setting {
  key   String @id
  value Json
}

// ───────────────────────── PPC requests ─────────────────────────
model PpcRequest {
  id                 String            @id @default(uuid())
  requestNo          String            @unique // PR-0001
  name               String? // optional human label, e.g. "Dubai order — 1600 sqft stage"
  productId          String
  priority           Priority          @default(normal)
  pipelineTemplateId String?
  startDate          DateTime?
  targetDate         DateTime?
  status             PpcStatus         @default(draft)
  createdById        String
  clarificationNote  String?
  approvedJobId      String?
  saleSheetId        String?           @unique // originating sale sheet (if from Sales)
  createdAt          DateTime          @default(now())
  product            Product           @relation(fields: [productId], references: [id])
  pipeline           PipelineTemplate? @relation(fields: [pipelineTemplateId], references: [id])
  saleSheet          SaleSheet?        @relation(fields: [saleSheetId], references: [id])
  models             PpcRequestModel[]
}

model PpcRequestModel {
  id        String     @id @default(uuid())
  requestId String
  modelId   String
  size      String?
  quantity  Int
  request   PpcRequest @relation(fields: [requestId], references: [id])
  model     Model      @relation(fields: [modelId], references: [id])
}

// ───────────────────────── jobs (core) ─────────────────────────
model Job {
  id                      String    @id @default(uuid())
  jobNo                   String    @unique // opaque immutable key
  displayLabel            String // AT-U-045-060626-001 (regenerable)
  name                    String? // optional human label carried from the PPC request
  designFileUrl           String?   @db.Text // optional design file (data URL) attached when Design forwards
  jobType                 JobType   @default(production)
  productId               String
  priority                Priority  @default(normal)
  totalQty                Int
  status                  JobStatus @default(draft)
  pipelineTemplateId      String
  parentJobId             String? // split: child jobs point at the parent
  designDoneAt            DateTime? // docs/12 §1a: Design confirmed → back to PPC (awaiting forward)
  forwardedAt             DateTime? // §1a: PPC forwarded to Production (production may start)
  workflowVersionId       String? // workflow-engine: the version this job's steps were snapshotted from
  orderId                 String? // order-layer: the sales order this job fulfils
  orderItemId             String? // which order line-item this job makes
  source                  JobSource @default(admin)
  ppcRequestId            String?
  startDate               DateTime?
  completionDate          DateTime?
  reworkIssue             String?
  reworkEntryDepartmentId String?
  createdById             String
  cancelledReason         String?
  version                 Int       @default(0) // optimistic lock
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  product          Product           @relation(fields: [productId], references: [id])
  pipeline         PipelineTemplate  @relation(fields: [pipelineTemplateId], references: [id])
  workflowVersion  WorkflowVersion?  @relation(fields: [workflowVersionId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  orderItem        OrderItem?        @relation(fields: [orderItemId], references: [id])
  models           JobModel[]
  steps            JobStep[]
  events           JobEvent[]
  scans            ScanEvent[]
  holds            Hold[]
  qc               QcInspection[]
  closure          Closure?
  materials        MaterialUsage[]
  serials          Serial[]
  stationVisits    StationVisit[] // production station scan trail (free / parallel)
  materialRequests MaterialRequest[] // parallel raw-material / purchase needs
  qcObservations   QcObservation[] // parallel QC reports raised at any station, any time
}

// Purchase logs the raw material consumed by a job (traceability/genealogy).
model MaterialUsage {
  id           String   @id @default(uuid())
  jobId        String
  item         String
  materialType String?
  vendor       String?
  batchRef     String?
  quantity     String? // freeform, e.g. "120 kg" / "40 pcs"
  loggedById   String
  createdAt    DateTime @default(now())
  job          Job      @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([batchRef])
}

// FG records a serial number per produced unit (searchable).
model Serial {
  id        String   @id @default(uuid())
  jobId     String
  serialNo  String
  modelCode String?
  size      String?
  addedById String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id])

  @@unique([serialNo])
  @@index([jobId])
}

model JobModel {
  id       String  @id @default(uuid())
  jobId    String
  modelId  String
  size     String? // chosen length for this line, e.g. "3M"
  quantity Int
  job      Job     @relation(fields: [jobId], references: [id])
  model    Model   @relation(fields: [modelId], references: [id])
}

// the workflow state machine — one row per pipeline department, snapshotted at creation
model JobStep {
  id            String     @id @default(uuid())
  jobId         String
  departmentId  String
  stageType     StageType? // snapshot of the workflow stage type at creation
  sequence      Int
  status        StepStatus @default(pending)
  acceptedById  String?
  acceptedAt    DateTime?
  completedById String?
  completedAt   DateTime?
  slaDueAt      DateTime? // size-scaled SLA (docs/10 exception detection)
  version       Int        @default(0) // optimistic lock for concurrent scans
  job           Job        @relation(fields: [jobId], references: [id])
  department    Department @relation(fields: [departmentId], references: [id])
  holds         Hold[]

  @@unique([jobId, sequence])
}

// immutable timeline
model JobEvent {
  id          String       @id @default(uuid())
  jobId       String
  jobStepId   String?
  type        EventType
  actorId     String?
  body        String?
  meta        Json         @default("{}")
  createdAt   DateTime     @default(now())
  job         Job          @relation(fields: [jobId], references: [id])
  attachments Attachment[]

  @@index([jobId])
}

model Attachment {
  id         String         @id @default(uuid())
  jobEventId String
  kind       AttachmentKind
  objectKey  String // S3/MinIO key
  mime       String
  sizeBytes  Int
  width      Int?
  height     Int?
  event      JobEvent       @relation(fields: [jobEventId], references: [id])
}

model Hold {
  id              String    @id @default(uuid())
  jobId           String
  jobStepId       String
  reasonCode      HoldCode
  reasonText      String?
  createdById     String
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  escalationLevel Int       @default(0)
  job             Job       @relation(fields: [jobId], references: [id])
  step            JobStep   @relation(fields: [jobStepId], references: [id])
}

// barcode scan log — the advance engine (docs/10)
model ScanEvent {
  id                  String     @id @default(uuid())
  jobId               String
  stationDepartmentId String
  scannedById         String
  clientTs            DateTime
  serverTs            DateTime   @default(now())
  idempotencyKey      String     @unique // client UUID per physical scan → dedup
  result              ScanResult
  note                String?
  job                 Job        @relation(fields: [jobId], references: [id])
  station             Department @relation(fields: [stationDepartmentId], references: [id])
  scannedBy           User       @relation(fields: [scannedById], references: [id])

  @@index([jobId])
}

model QcInspection {
  id              String   @id @default(uuid())
  jobId           String
  result          QcResult
  inspectorId     String
  notes           String? // required when result = rework — the issue description
  photoUrl        String?  @db.Text // optional compressed JPEG data URL of the defect
  reworkStationId String? // QC may target a specific production station; else back to Production generically
  reworkJobId     String?
  createdAt       DateTime @default(now())
  job             Job      @relation(fields: [jobId], references: [id])
}

model Closure {
  id            String        @id @default(uuid())
  jobId         String        @unique
  requestedById String
  requestedAt   DateTime      @default(now())
  approvedById  String?
  approvedAt    DateTime?
  status        ClosureStatus @default(requested)
  receivedQty   Int
  job           Job           @relation(fields: [jobId], references: [id])
}

// ───────────────────────── maintenance ─────────────────────────
model MaintenanceTicket {
  id              String             @id @default(uuid())
  ticketNo        String             @unique // MT-0001
  category        MaintCategory
  priority        MaintPriority      @default(normal)
  status          MaintStatus        @default(open)
  locationText    String
  description     String
  reportedById    String
  assignedToId    String?
  closedById      String?
  etaHours        Int? // assignee's expected time to fix
  partsNeeded     String? // parts/replacements required
  closeRemark     String?
  photoUrl        String?            @db.Text // compressed JPEG data URL of the issue (optional)
  escalationLevel Int                @default(0) // 0=none, 1=ack-breach re-notified, 2=assign-breach escalated to admin
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  events          MaintenanceEvent[]
}

model MaintenanceEvent {
  id        String            @id @default(uuid())
  ticketId  String
  type      String
  actorId   String?
  body      String?
  createdAt DateTime          @default(now())
  ticket    MaintenanceTicket @relation(fields: [ticketId], references: [id])
}

// ───────────────────────── notifications, audit, AI, sequences ─────────────────────────
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  jobId     String?
  ticketId  String?
  entityId  String? // generic link target (e.g. PPC request id) so a tap opens it directly
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}

model AuditLog {
  id       String   @id @default(uuid())
  entity   String
  entityId String
  action   String
  actorId  String?
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
}

// AI suggestions (docs/08) — read-only assistant writes here; humans act, logged in audit
model Suggestion {
  id        String           @id @default(uuid())
  kind      SuggestionKind
  severity  Severity
  title     String
  detail    String
  jobId     String?
  ticketId  String?
  action    String
  source    String           @default("rule") // rule | llm
  status    SuggestionStatus @default(open)
  actedById String?
  createdAt DateTime         @default(now())
}

// atomic daily counters for the 001 sequence in job/PR/MT ids
model DailySequence {
  scope     String @id // e.g. "job:AT:2026-06-08"
  lastValue Int    @default(0)
}

// In-app feedback / bug reports raised from the floating reporter button.
enum FeedbackKind {
  bug
  idea
  feedback
}

enum FeedbackSeverity {
  low
  normal
  high
  critical
}

enum FeedbackStatus {
  open
  resolved
}

model Feedback {
  id            String           @id @default(uuid())
  kind          FeedbackKind     @default(bug)
  severity      FeedbackSeverity @default(normal)
  status        FeedbackStatus   @default(open)
  screen        String? // which screen it was opened from
  remark        String // the user's description
  context       Json             @default("{}") // captured diagnostics/log
  screenshot    String? // optional base64 data URL of the screen capture
  image         String? // optional user-attached image (base64 data URL)
  audio         String? // optional voice note (base64 data URL) for later transcription
  createdById   String?
  createdByName String?
  createdAt     DateTime         @default(now())
  resolvedAt    DateTime?

  @@index([status])
  @@index([createdAt])
}

// ───────────────────────── production stations (pipeline-v2) ─────────────────────────
// Stations live UNDER the single PRODUCTION department. They are tracking entities,
// NOT gated pipeline steps — a job is scanned at them freely / in parallel, and the
// scanned order IS the route record. (Replaces the old per-station gated departments.)
model Station {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  sortOrder    Int            @default(0)
  isCritical   Boolean        @default(false) // FG soft-flags a close if a critical station was never scanned
  departmentId String // the PRODUCTION department
  department   Department      @relation(fields: [departmentId], references: [id])
  visits       StationVisit[]
  qcObservations QcObservation[]
}

// docs/12 QC-as-parallel-department: QC sits at every station and may raise a report
// against ANY active job at ANY time — independent of the pipeline (no gate, no handoff).
// Reports are auto-tagged to the station the QC inspector is standing at. An `issue`
// SOFT-flags by default (work continues, FG close is flagged + admin notified); QC may
// request a HARD HOLD which needs ADMIN APPROVAL to engage and then blocks FG/dispatch.
// `suggestion` / `note` are purely advisory. Resolved by QC or the Production head.
enum QcKind {
  issue
  suggestion
  note
}

enum QcSeverity {
  minor
  major
  critical
}

enum QcObsStatus {
  open
  resolved
  dismissed
}

model QcObservation {
  id             String      @id @default(uuid())
  jobId          String
  stationId      String? // the station the QC inspector was at (auto-tagged); null = general
  kind           QcKind      @default(issue)
  severity       QcSeverity? // for issues; null for suggestion/note
  note           String      @db.Text
  photoUrl       String?     @db.Text // optional compressed JPEG data URL
  // hold / hard-block (issue only): QC requests, ADMIN approves to engage.
  holdRequested  Boolean     @default(false)
  holdApproved   Boolean     @default(false) // true = hard block ACTIVE (FG/dispatch blocked)
  holdApprovedById String?
  holdApprovedAt DateTime?
  // lifecycle
  status         QcObsStatus @default(open)
  raisedById     String
  raisedAt       DateTime    @default(now())
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  job            Job         @relation(fields: [jobId], references: [id])
  station        Station?    @relation(fields: [stationId], references: [id])

  @@index([jobId])
  @@index([stationId, status])
  @@index([status])
}

// One scan-in→scan-out at a station. Multiple may be OPEN at once for the same job
// (genuine parallel work). scanOut is preferred-explicit; if the operator forgets and
// the job moves on, it auto-closes (scanOutMode=auto) and the UI renders the time with ★.
model StationVisit {
  id           String       @id @default(uuid())
  jobId        String
  stationId    String
  operatorId   String // who scanned / worked (plain id, matches maintenance convention)
  scanInAt     DateTime     @default(now())
  scanOutAt    DateTime?
  scanOutMode  ScanOutMode? // null while open; explicit | auto(★) once closed
  remark       String? // what they did
  photoUrl     String?      @db.Text // optional compressed JPEG data URL
  // per-station QC (docs/12 phase 4): a QC person marks the visit checked / issue.
  // Non-blocking for movement; an OPEN issue (qcIssue && !qcResolvedAt) blocks FG close.
  qcChecked    Boolean      @default(false)
  qcIssue      Boolean      @default(false)
  qcNote       String?
  qcById       String?
  qcAt         DateTime?
  qcResolvedAt DateTime?
  version      Int          @default(0) // optimistic lock for concurrent scans
  job          Job          @relation(fields: [jobId], references: [id])
  station      Station      @relation(fields: [stationId], references: [id])

  @@index([jobId])
  @@index([stationId])
}

// Sales desk creates a sale sheet, hands it to PPC, who converts it into a PpcRequest.
model SaleSheet {
  id          String          @id @default(uuid())
  sheetNo     String          @unique // SS-0001
  customer    String // customer / vendor name
  orderName   String? // human label e.g. "Dubai order — 1600 sqft stage"
  details     String?         @db.Text // freeform scope / spec
  targetDate  DateTime?
  status      SaleSheetStatus @default(draft)
  createdById String // the Sales user
  createdAt   DateTime        @default(now())
  request     PpcRequest? // set once converted
}

// A raw-material / purchase need raised against a job. Non-blocking: production keeps
// working on available parts. Actual ordering is OFF-app; this just tracks the state.
model MaterialRequest {
  id         String         @id @default(uuid())
  jobId      String
  item       String // what's needed
  quantity   String? // freeform e.g. "120 kg" / "40 pcs"
  status     MaterialStatus @default(needed)
  note       String?
  vendor     String? // optional off-app ordering reference
  raisedById String // design / floor user who flagged the shortage
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  job        Job            @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([status])
}

// ───────────────────────── workflow engine (docs/12) ─────────────────────────
// The company-wide business pipeline as VERSIONED data. Stages are typed; jobs
// snapshot the published version at creation, so publishing a new version never
// re-routes in-flight jobs (the core correctness property, R5).
model WorkflowDefinition {
  id                 String            @id @default(uuid())
  name               String // "GRYNX Factory Workflow"
  isActive           Boolean           @default(true)
  publishedVersionId String?           @unique
  createdAt          DateTime          @default(now())
  versions           WorkflowVersion[] @relation("DefinitionVersions")
  publishedVersion   WorkflowVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
}

model WorkflowVersion {
  id           String              @id @default(uuid())
  definitionId String
  version      Int
  status       WorkflowStatus      @default(draft)
  note         String?
  createdById  String
  createdAt    DateTime            @default(now())
  publishedAt  DateTime?
  definition   WorkflowDefinition  @relation("DefinitionVersions", fields: [definitionId], references: [id])
  publishedFor WorkflowDefinition? @relation("PublishedVersion")
  stages       WorkflowStage[]
  jobs         Job[]

  @@unique([definitionId, version])
}

model WorkflowStage {
  id           String          @id @default(uuid())
  versionId    String
  stageType    StageType
  departmentId String? // department-backed stages (design/production/qc/fg); null for sales/dispatch
  label        String // display name, e.g. "Production"
  sequence     Int
  config       Json            @default("{}") // per-stage config (who acts, SLA, conditions later)
  version      WorkflowVersion @relation(fields: [versionId], references: [id])
  department   Department?     @relation(fields: [departmentId], references: [id])

  @@unique([versionId, sequence])
  @@index([versionId])
}

// ───────────────────────── order layer (docs/12 phase 3) ─────────────────────
// Top-level Sales order. Holds line-items; PPC raises a Job per item that needs
// production (items already in FG stock are fulfilled from stock — phase 5).
// Whole-order completion = all sub-jobs closed; dispatch ships the WHOLE order.
model Order {
  id          String      @id @default(uuid())
  orderNo     String      @unique // ORD-0001 (app-generated id)
  name        String? // human-friendly, e.g. "SS Production 60x40 Truss"
  client      String // customer / vendor
  notes       String?     @db.Text
  priority    Priority    @default(normal)
  targetDate  DateTime?
  status      OrderStatus @default(draft)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
  jobs        Job[]
  dispatch    Dispatch?

  @@index([status])
}

model OrderItem {
  id          String     @id @default(uuid())
  orderId     String
  productId   String
  modelId     String?
  size        String?
  quantity    Int
  fromStock   Boolean    @default(false) // PPC marked: fulfilled from existing FG stock
  stockItemId String? // phase 5: the StockItem this item reserved from (when fromStock)
  note        String?
  order       Order      @relation(fields: [orderId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])
  model       Model?     @relation(fields: [modelId], references: [id])
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])
  jobs        Job[]

  @@index([orderId])
}

// ───────────────────────── FG inventory (docs/12 phase 5) ────────────────────
// Finished-goods stock per product+model+size. available = onHand − reserved.
// `version` is the optimistic lock that prevents double-allocation (R2): every
// reserve/produce/dispatch reads version, writes version+1, retries on conflict.
model StockItem {
  id         String          @id @default(uuid())
  productId  String
  modelId    String?
  size       String?
  onHand     Int             @default(0) // physically in FG
  reserved   Int             @default(0) // promised to orders (available = onHand − reserved)
  version    Int             @default(0) // optimistic lock — DO NOT bypass
  updatedAt  DateTime        @updatedAt
  product    Product         @relation(fields: [productId], references: [id])
  model      Model?          @relation(fields: [modelId], references: [id])
  movements  StockMovement[]
  orderItems OrderItem[]

  @@unique([productId, modelId, size])
}

enum StockMoveKind {
  opening // FG entered existing/opening stock
  adjust // manual correction / stock-take
  produced // a job closed → units entered FG
  reserve // PPC reserved for an order (from stock)
  release // reservation freed (undo / reallocate / cancel)
  dispatch // shipped out (on-hand drops)
}

model StockMovement {
  id            String        @id @default(uuid())
  stockItemId   String
  kind          StockMoveKind
  qty           Int // units moved (always positive; `kind` says what changed)
  onHandAfter   Int
  reservedAfter Int
  orderId       String?
  orderItemId   String?
  jobId         String?
  clientTag     String? // "made for <client>" provenance
  actorId       String
  note          String?
  createdAt     DateTime      @default(now())
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id])

  @@index([stockItemId])
}

// ───────────────────────── dispatch (docs/12 phase 6) ────────────────────────
// Ships the WHOLE order (never partial). Two-way trigger: Sales requests → admin
// approves, OR FG auto-raises when every item is in stock. Shipping DEDUCTS stock.
enum DispatchStatus {
  requested
  approved
  shipped
  cancelled
}

model Dispatch {
  id            String         @id @default(uuid())
  orderId       String         @unique
  status        DispatchStatus @default(requested)
  raisedBy      String // 'sales' | 'fg' | 'admin' — who/what raised it
  requestedById String
  approvedById  String?
  approvedAt    DateTime?
  shippedById   String?
  shippedAt     DateTime?
  vehicle       String?
  note          String?
  createdAt     DateTime       @default(now())
  order         Order          @relation(fields: [orderId], references: [id])
}
